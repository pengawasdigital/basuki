# ==============================================================================
# KONFIGURASI SUPABASE (Database PostgreSQL & Autentikasi)
# ==============================================================================
# URL Project Supabase Anda (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Public Key (Aman digunakan di frontend client)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role Key (Opsional, HANYA untuk backend server jika diperlukan bypass RLS administratif)
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Disediakan otomatis oleh sistem AI Studio jika fitur AI digunakan
GEMINI_API_KEY=""

# APP_URL: URL hosting aplikasi (disediakan otomatis oleh lingkungan runtime)
APP_URL=""

# API_URL (Opsional): Endpoint URL backend API (bawaan relative path "/api")
API_URL="/api"
